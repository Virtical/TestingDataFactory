        <PackageReference Include="OpenAI" Version="2.14.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TestingDataFactory.Contracts\TestingDataFactory.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\..\.dockerignore">
